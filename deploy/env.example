# Copy to  /opt/suara/.env  on the VPS and fill in real values.
# chmod 600 .env  &&  chown $USER:$USER .env    (never commit this file)

# --- Database -------------------------------------------------------------
# Postgres + PgBouncer both run as containers (see docker-compose.yml).
# These three seed the `db` container and PgBouncer auth — keep them in sync
# with the passwords in the URLs below.
POSTGRES_USER="suara"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="suara"

# Runtime: through the pgbouncer container (transaction pool). pgbouncer=true
# disables prepared statements (required for transaction pooling).
DATABASE_URL="postgresql://suara:CHANGE_ME@pgbouncer:6432/suara?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15"
# Direct, non-pooled — used only by `prisma db push` (compose run app ...).
DIRECT_DATABASE_URL="postgresql://suara:CHANGE_ME@db:5432/suara"

# --- Cache (Phase 2; app falls back to direct DB when unset) -------------
REDIS_URL="redis://redis:6379"

# --- Auth --------------------------------------------------------------- -
SESSION_SECRET="generate with: openssl rand -base64 32"
ADMIN_EMAIL="admin@ppgtkpj.org"
ADMIN_PASSWORD="CHANGE_ME"
ADMIN_NAME="Administrator"

# --- Public URL / email ----------------------------------------------- ---
NEXT_PUBLIC_APP_URL="https://www.suarappgtkpj.site"
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="no-reply@ppgtkpj.org"
RESEND_FROM_NAME="Suara PPGT KPJ"
