generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the Docker image runs on Debian bookworm
  // (OpenSSL 3.x) — pin it so the query engine is always bundled regardless
  // of what the build host auto-detects.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // App runtime connection — point this at a connection pooler (Aiven PgBouncer)
  // in serverless deployments, with `?pgbouncer=true&connection_limit=1`.
  url       = env("DATABASE_URL")
  // Direct, non-pooled connection used only for `prisma migrate` / `db push`.
  // Set it to the same value as DATABASE_URL when you are not using a pooler.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum EventStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StageStatus {
  NOT_STARTED
  CHECK_IN
  VOTING
  STOPPED
  CLOSED
}

enum SelectionSource {
  MANUAL
  AUTO_THRESHOLD
  PROMOTED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Event {
  id                String      @id @default(cuid())
  publicId          String      @unique
  name              String
  description       String      @default("")
  bannerImage       String?
  status            EventStatus @default(INACTIVE)
  order             Int         @default(0)
  expectedParticipants Int      @default(0)
  resultsRevealed   Boolean     @default(false)
  tokenPrefix       String      @default("TOK-")
  tokenSuffix       String      @default("")
  tokenEmailSubject String?
  tokenEmailBody    String?
  useCredentials    Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  stages       Stage[]
  participants Participant[]
  auditLogs    AuditLog[]
  credentials  Credential[]
}

model Credential {
  id            String       @id @default(cuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  jemaat        String
  email         String?
  participantId String?      @unique
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([eventId])
}

model Stage {
  id             String      @id @default(cuid())
  eventId        String
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order          Int
  name           String
  status         StageStatus @default(NOT_STARTED)
  resultsOpen    Boolean     @default(false)
  allowAbstain   Boolean     @default(false)
  requireFingerprint Boolean @default(true)
  // How many top candidates (by vote count) advance to the next stage when the
  // admin clicks "promote by rule". 0 = not set / manual promotion only.
  promoteCount   Int         @default(0)
  startedAt      DateTime?
  completedAt    DateTime?

  candidates Candidate[]
  votes      Vote[]
  checkIns   StageCheckIn[]

  @@unique([eventId, order])
}

model StageCheckIn {
  id            String      @id @default(cuid())
  stageId       String
  stage         Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([stageId, participantId])
  @@index([stageId])
}

model Candidate {
  id            String       @id @default(cuid())
  stageId       String
  stage         Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name          String
  note          String       @default("")
  photo         String?
  order         Int
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  selectionSource SelectionSource @default(MANUAL)

  votes Vote[]
}

model Participant {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String?
  jemaat       String?
  token        String    @unique
  email        String?
  photo        String?
  deviceId     String?
  deviceLabel  String?
  registeredAt DateTime?
  validatedAt  DateTime?
  tokenSentAt  DateTime?
  createdAt    DateTime  @default(now())

  votes      Vote[]
  candidacies Candidate[]
  credential  Credential?
  checkIns   StageCheckIn[]

  @@index([eventId])
}

model Vote {
  id            String      @id @default(cuid())
  stageId       String
  stage         Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  candidateId   String?
  candidate     Candidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  isAbstain     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([stageId, participantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  message   String
  actor     String
  createdAt DateTime @default(now())

  @@index([eventId])
}
